  "item": [
    {
      "name": "01. Authentication",
      "description": "Foydalanuvchini ro'yxatdan o'tkazish, tizimga kirish (JWT), tokenni yangilash va profil boshqaruvi.",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"StrongPass123!\",\n  \"password_confirm\": \"StrongPass123!\",\n  \"first_name\": \"Aziz\",\n  \"last_name\": \"Karimov\",\n  \"phone_number\": \"+998901234567\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register", ""]
            },
            "description": "Yangi foydalanuvchini ro'yxatdan o'tkazish. Muvaffaqiyatli bo'lsa 201 Created qaytadi."
          },
          "response": []
        },
        {
          "name": "Login (User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.access) {",
                  "        pm.environment.set(\"accessToken\", jsonData.access);",
                  "    }",
                  "    if (jsonData.refresh) {",
                  "        pm.environment.set(\"refreshToken\", jsonData.refresh);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"StrongPass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login", ""]
            },
            "description": "Oddiy foydalanuvchi sifatida tizimga kirish. Access va Refresh tokenlarni avtomatik `{{accessToken}}` ga saqlaydi."
          },
          "response": []
        },
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.access) {",
                  "        pm.environment.set(\"adminAccessToken\", jsonData.access);",
                  "    }",
                  "    if (jsonData.refresh) {",
                  "        pm.environment.set(\"adminRefreshToken\", jsonData.refresh);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"AdminPass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login", ""]
            },
            "description": "Admin foydalanuvchi sifatida tizimga kirish. Access tokenni `{{adminAccessToken}}` ga saqlaydi."
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.access) {",
                  "        pm.environment.set(\"accessToken\", jsonData.access);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/token/refresh/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "token", "refresh", ""]
            },
            "description": "Refresh token orqali yangi access token olish."
          },
          "response": []
        },
