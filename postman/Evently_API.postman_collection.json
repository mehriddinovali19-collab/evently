    {
      "name": "02. Events",
      "description": "Tadbirlarni ko'rish, qidirish, admin tomonidan CRUD va yopish amallari.",
      "item": [
        {
          "name": "List Events (All / Filtered)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/?page=1&event_type=masterclass&status=open&upcoming=true&search=django&ordering=start_at",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "events", ""],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Sahifa raqami (sahifada 10 ta)"
                },
                {
                  "key": "event_type",
                  "value": "masterclass",
                  "description": "Tadbir turi bo'yicha filter (seminar, masterclass, workshop)"
                },
                {
                  "key": "status",
                  "value": "open",
                  "description": "Holat bo'yicha filter (open, full, cancelled, completed)"
                },
                {
                  "key": "upcoming",
                  "value": "true",
                  "description": "Faqat kelgusi (boshlanmagan) tadbirlar"
                },
                {
                  "key": "search",
                  "value": "django",
                  "description": "Sarlavha (title) va tavsif (description) bo'yicha qidiruv"
                },
                {
                  "key": "ordering",
                  "value": "start_at",
                  "description": "Tartiblash: start_at, -start_at, created_at"
                }
              ]
            },
            "description": "Tadbirlar ro'yxatini olish. Pagination, qidiruv va filtrlash parametrlari kiritilgan."
          },
          "response": []
