    {
      "name": "04. Telegram Integration",
      "description": "Saytdagi akkauntni Telegram bot bilan bog'lash oqimi.",
      "item": [
        {
          "name": "1. Get Telegram Link Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.link) {",
                  "        var match = jsonData.link.match(/start=([^&]+)/);",
                  "        if (match && match[1]) {",
                  "            pm.environment.set(\"telegramLinkToken\", match[1]);",
                  "        }",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/telegram/link/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "telegram", "link", ""]
            },
            "description": "Foydalanuvchi saytda Telegramni ulash tugmasini bosganda bir martalik havola generatsiya qilinadi. Havoladagi token avtomatik `{{telegramLinkToken}}` ga olinadi."
          },
          "response": []
        },
        {
          "name": "2. Confirm Telegram Linking (Bot API)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Bot-Secret",
                "value": "{{botApiSecret}}",
                "description": "Faqat Telegram bot bilishi kerak bo'lgan maxfiy ichki kalit"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{telegramLinkToken}}\",\n  \"chat_id\": 123456789\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/telegram/confirm/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "telegram", "confirm", ""]
            },
            "description": "Telegram bot foydalanuvchining `/start <token>` buyrug'ini qabul qilgandan so'ng backendga yuboradigan so'rovi."
          },
          "response": []
        }
      ]
    },
